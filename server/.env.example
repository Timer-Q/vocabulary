NODE_ENV=development
PORT=3000

# Supabase PostgreSQL
# DATABASE_URL 使用 Supabase Transaction Pooler（适合应用运行时）
# DIRECT_URL 使用 Supabase Direct Connection（migrate / prisma:seed 必须用直连，Pooler 易中断）
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Supabase：Dashboard → Settings → API Keys
# https://supabase.com/dashboard/project/<project-ref>/settings/api-keys
# 文档：https://supabase.com/docs/guides/api/api-keys
#
# SUPABASE_URL：Project URL（可与 Connect 对话框一致）
SUPABASE_URL="https://<project-ref>.supabase.co"
#
# SUPABASE_ANON_KEY：Publishable key（sb_publishable_...，推荐）
# 或 Legacy 标签页中的 anon（JWT）
SUPABASE_ANON_KEY=""
#
# SUPABASE_SERVICE_ROLE_KEY：Secret key（sb_secret_...，推荐，仅服务端）
# 或 Legacy 标签页中的 service_role（JWT）
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="media"
MINI_AUTH_BRIDGE_SECRET="replace-with-random-32-byte-secret"

REDIS_HOST=localhost
REDIS_PORT=6379

WEAPP_APP_ID=""
WEAPP_APP_SECRET=""
TT_APP_ID=""
TT_APP_SECRET=""

LLM_PROVIDER=deepseek
LLM_API_KEY=""
