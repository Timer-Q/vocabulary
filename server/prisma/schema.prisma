generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  weapp
  tt
}

enum RootOrigin {
  latin
  greek
  old_english
  french
  other
}

enum WordRootPosition {
  prefix
  root
  suffix
}

enum MorphemeKind {
  root
  prefix
  suffix
  combining_form
}

enum MorphemeLevel {
  core
  advanced
  specialist
}

enum RootRelationKind {
  cognate
  similar_meaning
  opposite
  similar_form
}

enum WordRelationKind {
  synonym
  antonym
  similar_form
}

enum ExampleLevel {
  basic
  exam
  classic
  advanced
  root_transfer
}

enum ExampleSource {
  cet4
  cet6
  kaoyan
  ielts
  toefl
  movie
  ted
  book
  ugc
  ai
  other
}

enum ContentStatus {
  draft
  pending
  published
  rejected
}

enum ReviewResult {
  unknown
  vague
  known
  mastered
}

model User {
  id          BigInt    @id @default(autoincrement())
  platform    Platform
  openId      String    @map("open_id") @db.VarChar(64)
  supabaseUserId String? @unique @map("supabase_user_id") @db.Uuid
  unionId     String?   @map("union_id") @db.VarChar(64)
  nickname    String?   @db.VarChar(64)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(512)
  status      Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  plan        UserPlan?
  progresses  UserWordProgress[]
  sessions    LearnSession[]

  @@unique([platform, openId])
  @@index([unionId])
  @@map("user")
}

model Word {
  id            BigInt   @id @default(autoincrement())
  spelling      String   @unique @db.VarChar(64)
  phoneticUk    String?  @map("phonetic_uk") @db.VarChar(64)
  phoneticUs    String?  @map("phonetic_us") @db.VarChar(64)
  audioUkUrl    String?  @map("audio_uk_url") @db.VarChar(512)
  audioUsUrl    String?  @map("audio_us_url") @db.VarChar(512)
  audioSlowUrl  String?  @map("audio_slow_url") @db.VarChar(512)
  frequency     Int?
  difficulty    Int?
  level         Json?
  pos           Json?
  scenes        Json?
  splitPattern  Json?    @map("split_pattern")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  roots         WordRoot[]
  morphemes     MorphemeWord[]
  examples      Example[]
  media         Media[]
  progresses    UserWordProgress[]
  relationsFrom WordRelation[] @relation("WordRelationFrom")
  relationsTo   WordRelation[] @relation("WordRelationTo")

  @@index([frequency])
  @@map("word")
}

model Root {
  id               BigInt     @id @default(autoincrement())
  form             String     @unique @db.VarChar(32)
  origin           RootOrigin
  meaning          String     @db.VarChar(255)
  extendedMeaning  String?    @map("extended_meaning") @db.Text
  story            String?    @db.Text
  storyImageUrl    String?    @map("story_image_url") @db.VarChar(512)
  derivativeCount  Int        @default(0) @map("derivative_count")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  words            WordRoot[]
  examples         Example[]
  relationsFrom    RootRelation[] @relation("RootRelationFrom")
  relationsTo      RootRelation[] @relation("RootRelationTo")

  @@map("root")
}

model Morpheme {
  id              BigInt        @id @default(autoincrement())
  form            String        @db.VarChar(64)
  normalizedForm  String        @map("normalized_form") @db.VarChar(64)
  kind            MorphemeKind
  origin          RootOrigin
  originLabel     String        @map("origin_label") @db.VarChar(128)
  meaning         String        @db.VarChar(255)
  extendedMeaning String?       @map("extended_meaning") @db.Text
  etymology       String?       @db.Text
  aliases         Json?
  examples        Json?
  tags            Json?
  level           MorphemeLevel @default(core)
  frequencyRank   Int?          @map("frequency_rank")
  productivity    Int           @default(0)
  derivativeCount Int           @default(0) @map("derivative_count")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  words           MorphemeWord[]

  @@unique([kind, normalizedForm])
  @@index([kind, origin])
  @@index([level, kind])
  @@index([frequencyRank])
  @@map("morpheme")
}

model RootRelation {
  id         BigInt           @id @default(autoincrement())
  fromRootId BigInt           @map("from_root_id")
  toRootId   BigInt           @map("to_root_id")
  kind       RootRelationKind
  weight     Int              @default(1)

  fromRoot Root @relation("RootRelationFrom", fields: [fromRootId], references: [id])
  toRoot   Root @relation("RootRelationTo", fields: [toRootId], references: [id])

  @@unique([fromRootId, toRootId, kind])
  @@index([fromRootId])
  @@index([toRootId])
  @@map("root_relation")
}

model WordRelation {
  id         BigInt           @id @default(autoincrement())
  fromWordId BigInt           @map("from_word_id")
  toWordId   BigInt           @map("to_word_id")
  kind       WordRelationKind
  weight     Int              @default(1)

  fromWord Word @relation("WordRelationFrom", fields: [fromWordId], references: [id])
  toWord   Word @relation("WordRelationTo", fields: [toWordId], references: [id])

  @@unique([fromWordId, toWordId, kind])
  @@index([fromWordId])
  @@index([toWordId])
  @@map("word_relation")
}

model WordRoot {
  id           BigInt           @id @default(autoincrement())
  wordId       BigInt           @map("word_id")
  rootId       BigInt           @map("root_id")
  position     WordRootPosition
  order        Int
  displayForm  String?          @map("display_form") @db.VarChar(32)

  word         Word             @relation(fields: [wordId], references: [id])
  root         Root             @relation(fields: [rootId], references: [id])

  @@unique([wordId, order])
  @@index([rootId])
  @@map("word_root")
}

model MorphemeWord {
  id           BigInt           @id @default(autoincrement())
  wordId       BigInt           @map("word_id")
  morphemeId   BigInt           @map("morpheme_id")
  position     WordRootPosition
  order        Int
  displayForm  String?          @map("display_form") @db.VarChar(32)

  word         Word             @relation(fields: [wordId], references: [id])
  morpheme     Morpheme         @relation(fields: [morphemeId], references: [id])

  @@unique([wordId, order])
  @@index([morphemeId])
  @@map("morpheme_word")
}

model Example {
  id             BigInt        @id @default(autoincrement())
  wordId         BigInt        @map("word_id")
  targetRootId   BigInt?       @map("target_root_id")
  sentence       String        @db.Text
  translation    String        @db.Text
  level          ExampleLevel
  source         ExampleSource
  sourceMeta     Json?         @map("source_meta")
  audioUkUrl     String?       @map("audio_uk_url") @db.VarChar(512)
  audioUsUrl     String?       @map("audio_us_url") @db.VarChar(512)
  audioSlowUrl   String?       @map("audio_slow_url") @db.VarChar(512)
  highlightSpans Json?         @map("highlight_spans")
  grammarTags    Json?         @map("grammar_tags")
  status         ContentStatus @default(draft)
  createdBy      String        @map("created_by") @db.VarChar(64)
  likes          Int           @default(0)
  reports        Int           @default(0)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  word           Word          @relation(fields: [wordId], references: [id])
  targetRoot     Root?         @relation(fields: [targetRootId], references: [id])

  @@index([wordId, level, status])
  @@index([targetRootId, status])
  @@map("example")
}

model Media {
  id            BigInt        @id @default(autoincrement())
  wordId        BigInt        @map("word_id")
  type          String        @db.VarChar(16)
  url           String        @db.VarChar(512)
  thumbUrl      String?       @map("thumb_url") @db.VarChar(512)
  durationMs    Int?          @map("duration_ms")
  isAiGenerated Boolean       @default(false) @map("is_ai_generated")
  status        ContentStatus @default(draft)
  createdAt     DateTime      @default(now()) @map("created_at")

  word          Word          @relation(fields: [wordId], references: [id])

  @@index([wordId])
  @@map("media")
}

model UserWordProgress {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  wordId         BigInt   @map("word_id")
  easeFactor     Decimal  @default(2.5) @map("ease_factor") @db.Decimal(4, 2)
  intervalDays   Int      @default(0) @map("interval_days")
  dueAt          DateTime @map("due_at")
  reviewCount    Int      @default(0) @map("review_count")
  lapses         Int      @default(0)
  mastery        Int      @default(1)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  lastResponseMs Int?     @map("last_response_ms")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user           User     @relation(fields: [userId], references: [id])
  word           Word     @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId])
  @@index([dueAt])
  @@map("user_word_progress")
}

model UserPlan {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @unique @map("user_id")
  examType    String   @map("exam_type") @db.VarChar(32)
  examDate    DateTime? @map("exam_date") @db.Date
  dailyNew    Int      @map("daily_new")
  dailyReview Int      @map("daily_review")
  status      String   @default("active") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id])

  @@map("user_plan")
}

model LearnSession {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  startedAt   DateTime @map("started_at")
  endedAt     DateTime? @map("ended_at")
  newCount    Int      @default(0) @map("new_count")
  reviewCount Int      @default(0) @map("review_count")
  accuracy    Decimal? @db.Decimal(4, 3)
  platform    Platform

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("learn_session")
}
